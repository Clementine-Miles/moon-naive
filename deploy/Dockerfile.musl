# syntax=docker/dockerfile:1
FROM rust:1.89.0-alpine3.22@sha256:4b800f2e72e04be908e5f634c504c741bd943b763d1d8ad7b096cc340e1b5b46 AS toolchain
RUN --mount=type=secret,id=system_ca \
    if [ -s /run/secrets/system_ca ]; then export SSL_CERT_FILE=/run/secrets/system_ca; fi; \
    apk add --no-cache build-base cmake clang19-libclang linux-headers perl pkgconf git
COPY tools/xtask/build-support/musl-host-rustc.rs /build/musl-host-rustc.rs
RUN rustc --edition=2024 -C target-feature=-crt-static /build/musl-host-rustc.rs -o /usr/local/bin/moon-naive-rustc-wrapper
ENV RUSTC_WRAPPER=/usr/local/bin/moon-naive-rustc-wrapper \
    LIBCLANG_PATH=/usr/lib/llvm19/lib \
    BINDGEN_EXTRA_CLANG_ARGS="-isystem /usr/lib/gcc/x86_64-alpine-linux-musl/14.2.0/include" \
    RUSTFLAGS="-C target-feature=+crt-static"
WORKDIR /src

FROM toolchain AS builder
COPY . .
RUN --mount=type=secret,id=system_ca \
    if [ -s /run/secrets/system_ca ]; then \
      export SSL_CERT_FILE=/run/secrets/system_ca CARGO_HTTP_CAINFO=/run/secrets/system_ca GIT_SSL_CAINFO=/run/secrets/system_ca; \
    fi; \
    cargo build --target x86_64-unknown-linux-musl --release --locked -p moon-naive

FROM scratch AS export
COPY --from=builder /src/target/x86_64-unknown-linux-musl/release/moon-naive /moon-naive
