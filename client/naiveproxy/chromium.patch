+int SpdyProxyClientSocket::PrepareRequestHeaders(
+    SpdySession& session, spdy::SpdyStreamId stream_id,
+    quiche::HttpHeaderBlock& headers) {
+  if (!moon_key_ || preamble_index_ || proxy_chain_.length() != 1 ||
+      proxy_chain_index_ != 0 || !proxy_chain_.Last().is_https()) {
+    return ERR_TUNNEL_CONNECTION_FAILED;
+  }
+  int result = session.ExportMoonKeyingMaterial(moon_binding_.exporter);
+  if (result != OK) return result;
+  moon_binding_.stream_id = stream_id;
+  moon_authority_ = endpoint_.ToString();
+  moon_naive::Request request{"CONNECT", moon_authority_, std::nullopt,
+                              std::nullopt, std::nullopt};
+  auto proof = moon_naive::Authorization(*moon_key_, moon_binding_, request);
+  if (proof.empty()) return ERR_TUNNEL_CONNECTION_FAILED;
+  headers["proxy-authorization"] = proof;
+  return OK;
 }
 
