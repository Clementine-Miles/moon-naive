+int QuicChromiumClientSession::Handle::ExportKeyingMaterial(
+    std::string_view label,
+    base::span<uint8_t> out) const {
+  if (!session_ || !session_->crypto_stream_) {
+    return ERR_CONNECTION_CLOSED;
+  }
+  // Every QUIC version this build supports is IETF QUIC with TLS 1.3.
+  if (!session_->OneRttKeysAvailable()) {
+    return ERR_SSL_PROTOCOL_ERROR;
+  }
+  // In TLS 1.3 an absent and an empty exporter context are identical.
+  std::string result;
+  if (!session_->crypto_stream_->ExportKeyingMaterial(label, /*context=*/"",
+                                                      out.size(), &result) ||
+      result.size() != out.size()) {
+    return ERR_SSL_PROTOCOL_ERROR;
+  }
+  out.copy_from(base::as_byte_span(result));
+  return OK;
+}
