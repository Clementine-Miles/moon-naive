+
+// ACME laboratory only: explicit server key logging, never a client TLS bypass.
+type labLockedWriter struct {
+	sync.Mutex
+	io.Writer
+}
+
+func (w *labLockedWriter) Write(p []byte) (int, error) {
+	w.Lock()
+	defer w.Unlock()
+	return w.Writer.Write(p)
+}
+func labListenTLS(addr, cert, key string, handler http.Handler) error {
+	if os.Getenv("PEBBLE_LAB_STALL_ORDER") == "1" {
+		next := handler
+		handler = http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			dir := os.Getenv("PEBBLE_LAB_BARRIER_DIR")
+			if strings.HasPrefix(r.URL.Path, "/my-order/") {
+				if _, err := os.Stat(dir + "/entered"); err == nil {
+					until := time.Now().Add(60 * time.Second)
+					for time.Now().Before(until) {
+						if _, err := os.Stat(dir + "/release"); err == nil {
+							break
+						}
+						time.Sleep(10 * time.Millisecond)
+					}
+				}
+			}
+			next.ServeHTTP(w, r)
+		})
+	}
+	config := &tls.Config{}
+	if path := os.Getenv("PEBBLE_LAB_KEYLOGFILE"); path != "" {
+		f, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0600)
+		if err != nil {
+			return err
+		}
+		defer f.Close()
+		config.KeyLogWriter = &labLockedWriter{Writer: f}
+	}
+	return (&http.Server{Addr: addr, Handler: handler, TLSConfig: config}).ListenAndServeTLS(cert, key)
+}
